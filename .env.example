# Optional. Everything runs without any of these.
# Provider for the inspection note: template (default), hf (local model) or openai
TRIAGE_PROVIDER=template
# Model id for the hf provider
TRIAGE_PROVIDER_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# OpenAI compatible endpoint, for example a local Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:0.5b-instruct
LLM_API_KEY=your-key-here
